generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
  TRANSFERRED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  STOPPED
  FAILED
}

model Patient {
  id          String        @id @default(uuid()) @db.Uuid
  patientId   String        @unique
  name        String
  age         Int
  gender      Gender
  dateOfBirth DateTime      @db.Timestamptz(3)
  deviceId    String        @unique
  roomNumber  String
  status      PatientStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  sessions    EcgSession[]

  @@index([status])
  @@index([roomNumber])
  @@index([deviceId])
  @@map("patients")
}

model EcgSession {
  id        String        @id @default(uuid()) @db.Uuid
  patientId String        @db.Uuid
  sessionId String        @unique
  startedAt DateTime      @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?     @db.Timestamptz(3)
  status    SessionStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  samples   EcgSample[]

  @@index([patientId, status])
  @@index([startedAt])
  @@map("ecg_sessions")
}

model EcgSample {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  timestamp DateTime @db.Timestamptz(3)
  lead      Int
  value     Float
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  session   EcgSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@index([sessionId, lead])
  @@map("ecg_samples")
}
